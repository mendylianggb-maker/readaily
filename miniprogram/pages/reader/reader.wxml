<view
  wx:if="{{loaded}}"
  class="reader"
  style="background: {{style.theme.bg}}; color: {{style.theme.text}}; font-size: {{style.fontSize}}rpx; line-height: {{style.lineHeight}}; font-family: {{style.fontFamily}};"
>
  <view class="header" style="color: {{style.theme.secondary}}">
    <view class="header-row">
      <text>{{header.dateText}} · {{header.dayText}} · 约 {{header.minutes}} 分钟</text>
      <text class="aa" bindtap="onSettings">Aa</text>
    </view>
    <view wx:if="{{header.label}}" class="header-label">{{header.label}}</view>
    <view class="progress"><view class="progress-bar" style="width: {{header.progress}}%"></view></view>
  </view>

  <view class="body">
    <block wx:for="{{blocks}}" wx:key="index">
      <view wx:if="{{item.type === 'h'}}" class="chapter-title">{{item.text}}</view>
      <text wx:else class="para" user-select>{{item.text}}</text>
    </block>
  </view>

  <view class="footer">
    <button wx:if="{{mode === 'read'}}" class="btn-primary" bindtap="onFinish">{{finishText}}</button>
    <view wx:elif="{{mode === 'reread'}}" class="footer-note">已读完 ✓</view>
    <view wx:else class="footer-note">{{previewHint}}</view>
  </view>
</view>

<!-- Shown after finishing a session -->
<view wx:if="{{result}}" class="mask" bindtap="onBack">
  <view class="sheet" catchtap="noop">
    <view class="sheet-icon">🎉</view>
    <view class="sheet-title">打卡成功</view>
    <view class="sheet-streak">已连续 {{result.streak}} 天</view>
    <view wx:if="{{result.newCards > 0}}" class="sheet-card">获得 {{result.newCards}} 张时光书签 🔖</view>
    <button wx:if="{{result.overdueIndex >= 0}}" class="btn-primary sheet-btn" bindtap="onCatchUp">去补读</button>
    <button wx:if="{{result.aheadIndex >= 0}}" class="sheet-btn" bindtap="onReadAhead">再读一天（{{result.aheadLabel}}）</button>
    <button class="sheet-btn" bindtap="onBack">返回</button>
  </view>
</view>
