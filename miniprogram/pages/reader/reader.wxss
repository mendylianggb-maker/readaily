.reader {
  min-height: 100vh;
  padding: 24rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.header {
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 40rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.aa {
  font-size: 30rpx;
  padding: 0 8rpx 0 24rpx;
}

.header-label {
  font-size: 28rpx;
}

.progress {
  height: 6rpx;
  background: rgba(128, 128, 128, 0.2);
  border-radius: 3rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--color-primary);
}

.chapter-title {
  font-size: 1.3em;
  font-weight: 600;
  margin: 48rpx 0 32rpx;
  line-height: 1.4;
}

.para {
  display: block;
  margin-bottom: 0.9em;
  text-align: justify;
}

.footer {
  margin-top: 64rpx;
}

.footer-note {
  text-align: center;
  font-size: 26rpx;
  opacity: 0.6;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  color: #222222;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx 64rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
  line-height: 1.6;
}

.sheet-icon {
  font-size: 80rpx;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 600;
}

.sheet-streak {
  color: #888888;
  margin-bottom: 16rpx;
}

.sheet-card {
  color: #b8860b;
  margin-bottom: 16rpx;
}

.sheet-btn {
  margin-top: 20rpx;
}

.result {
  text-align: center;
}

.panel .row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.opt {
  padding: 8rpx 20rpx;
  margin: 6rpx 12rpx 6rpx 0;
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.opt.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}
