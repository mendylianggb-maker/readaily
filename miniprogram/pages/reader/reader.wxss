.reader {
  width: 100%;
  overflow-x: hidden;
  min-height: 100vh;
  padding: 24rpx 56rpx 80rpx;
  box-sizing: border-box;
}

.header {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
  font-family: var(--font-sans);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.aa {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border: 1rpx solid;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-family: var(--font-serif);
}

.progress {
  height: 4rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
}

.chapter-title {
  font-size: 1.35em;
  font-weight: 700;
  text-align: center;
  margin: 72rpx 0 56rpx;
  line-height: 1.4;
}

.chapter-rule {
  width: 48rpx;
  height: 2rpx;
  margin: 32rpx auto 0;
  opacity: 0.6;
}

.body {
  width: 100%;
}

.para {
  margin-bottom: 0.9em;
  text-align: justify;
  white-space: normal;
  overflow-wrap: break-word;
  word-wrap: break-word;
}

.para:not(.cjk) {
  text-align: left; /* justified English leaves wide gaps on a narrow screen */
}

.para.cjk {
  word-break: break-all; /* Chinese text: wrap anywhere, never scroll sideways */
}

.footer {
  margin-top: 72rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid;
}

.footer-note {
  text-align: center;
  font-size: 26rpx;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(43, 38, 32, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--color-surface);
  color: var(--color-text);
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 48rpx 72rpx;
  font-family: var(--font-sans);
  font-size: 30rpx;
  line-height: 1.6;
}

.result {
  text-align: center;
}

.sheet-check {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 52rpx;
}

.sheet-title {
  font-size: 44rpx;
  font-weight: 700;
}

.sheet-streak {
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

.sheet-num {
  color: var(--color-primary);
  font-weight: 700;
}

.sheet-card {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-warn-bg);
  color: var(--color-gold);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.sheet-btn {
  margin-top: 20rpx;
}

.sheet-back {
  margin-top: 28rpx;
  padding: 12rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.panel .row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.continued {
  text-align: center;
  font-size: 0.85em;
  margin: 40rpx 0 48rpx;
}

/* Selectable text renders as nested inline boxes, so CSS text-indent would
   push whole boxes sideways. Chinese paragraphs are indented with two
   ideographic spaces in the text instead (see buildBlocks). */
.para-text {
  display: block;
}

/* Dictionary */
.w-on {
  background: var(--highlight);
  border-radius: 6rpx;
}

.mask.clear {
  background: transparent;
}

.word-sheet {
  box-shadow: 0 -8rpx 32rpx rgba(43, 38, 32, 0.16);
  padding-bottom: 64rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.word-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.word-title {
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 700;
}

.word-phonetic {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.word-note {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.word-def {
  margin-top: 8rpx;
}

.word-also {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.word-link {
  color: var(--color-primary);
  font-weight: 600;
}
