<view class="container" wx:if="{{view}}">
  <view class="topbar">
    <view>
      <view class="text-secondary">{{view.dateTitle.weekday}}</view>
      <view class="date serif">{{view.dateTitle.date}}</view>
    </view>
    <view class="topbar-right">
      <view class="pill" bindtap="onCalendar">
        <image class="pill-icon" src="/images/icons/streak.svg" />
        <text>连续 <text class="streak-num">{{view.streak}}</text> 天</text>
      </view>
      <view class="pill" bindtap="onCalendar">
        <image class="pill-icon" src="/images/icons/bookmark.svg" />
        <text>{{view.cards}}</text>
      </view>
      <view class="settings" bindtap="onSettings" aria-label="设置"><image class="settings-icon" src="/images/icons/settings.svg" /></view>
    </view>
  </view>

  <!-- No book on the shelf: onboarding guide -->
  <block wx:if="{{!view.book && !view.hasBooks}}">
    <view class="card">
      <view class="title serif">开始每天 10 分钟的阅读</view>
      <view class="steps">
        <view class="step"><text class="step-no">1</text>在手机「文件」里找到 txt 或 epub</view>
        <view class="step"><text class="step-no">2</text>点「分享」，发给微信「文件传输助手」</view>
        <view class="step"><text class="step-no">3</text>回到这里，点「导入书」，从聊天里选它</view>
        <view class="step"><text class="step-no">4</text>选好每天读多久，今天就能开始读第一段</view>
      </view>
    </view>
    <button class="btn-primary" bindtap="onImport">导入书</button>
  </block>

  <!-- Books exist but none is being read -->
  <block wx:elif="{{!view.book}}">
    <view class="card center">
      <view class="title serif">现在没有在读的书</view>
      <view class="text-secondary">去书架选一本开始读吧。</view>
    </view>
    <button class="btn-primary" bindtap="onBookshelf">去书架</button>
  </block>

  <block wx:else>
    <view class="card today">
      <view class="book">
        <book-cover title="{{view.book.title}}" author="{{view.book.author}}" cover-path="{{view.book.coverPath}}" size="small" />
        <view class="book-info">
          <view class="book-title serif">{{view.book.title}}</view>
          <view wx:if="{{view.book.author}}" class="text-secondary">{{view.book.author}}</view>
          <view class="text-secondary end">预计 {{view.endLabel}} 读完</view>
        </view>
        <view class="ring" style="width: 128rpx; height: 128rpx; background: conic-gradient(#3E6B4E 0 {{view.progress}}%, #EDE5D6 {{view.progress}}% 100%)">
          <view class="ring-inner" style="width: 104rpx; height: 104rpx">
            <text class="ring-pct serif">{{view.progress}}%</text>
            <text class="ring-sub">{{view.doneCount}}/{{view.totalSessions}} 天</text>
          </view>
        </view>
      </view>

      <view class="session">
        <block wx:if="{{view.todaySession}}">
          <view class="text-secondary session-meta">今日阅读 · 第 {{view.todaySession.day}} 天 · 约 {{view.dailyMinutes}} 分钟</view>
          <view class="session-label serif">{{view.todaySession.label || '今天的阅读'}}</view>
        </block>
        <block wx:else>
          <view class="text-secondary session-meta">今天 {{view.todayLabel}}</view>
          <view class="session-label serif">今天没有排新的内容</view>
        </block>
      </view>

      <button wx:if="{{view.todaySession && !view.todaySession.done}}" class="btn-primary" bindtap="onReadToday">开始阅读</button>
      <block wx:else>
        <view wx:if="{{view.todaySession}}" class="done">今天的已经读完了 ✓</view>
        <button wx:if="{{view.aheadIndex >= 0}}" class="btn-secondary" bindtap="onReadAhead">提前读 {{view.aheadLabel}} 的</button>
      </block>
    </view>

    <view wx:if="{{view.rescheduleReason}}" class="banner">
      <text wx:if="{{view.rescheduleReason === 'behind'}}">落后 {{view.overdueCount}} 天了</text>
      <text wx:else>已经提前读了 {{view.aheadCount}} 天</text>
      <text class="link" bindtap="onReschedule">重新排期 ›</text>
    </view>
    <view wx:if="{{view.rescheduleReason !== 'behind' && view.overdueCount > 0}}" class="banner">
      <text>有 {{view.overdueCount}} 天待补读（从 {{view.firstOverdueLabel}} 开始）</text>
      <text class="link" bindtap="onCatchUp">去补读 ›</text>
    </view>
    <view wx:if="{{view.rescheduleReason === 'behind'}}" class="catchup-link text-secondary" bindtap="onCatchUp">或者继续补读 {{view.firstOverdueLabel}} 的 ›</view>

    <view class="card week-card">
      <view class="week-head">
        <text class="text-secondary">本周</text>
        <text class="link" bindtap="onCalendar">完整日历 ›</text>
      </view>
      <view class="week">
        <view wx:for="{{view.week}}" wx:key="date" class="week-day" data-index="{{item.index}}" bindtap="onWeekDay">
          <view class="text-secondary">{{item.name}}</view>
          <view class="dot state-{{item.state}} {{item.isToday ? 'is-today' : ''}}">{{item.day}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
