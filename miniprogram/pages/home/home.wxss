.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32rpx;
}

.date {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
}

.topbar-right {
  display: flex;
  align-items: center;
}

.topbar-right .pill {
  margin-left: 14rpx;
}

.pill-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.streak-num {
  color: var(--color-primary);
  font-weight: 700;
}

.settings {
  width: 40rpx;
  height: 40rpx;
  padding: 16rpx;
  margin-right: -16rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.step {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.step-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-on-primary);
  text-align: center;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.center {
  text-align: center;
}

.book {
  display: flex;
  align-items: center;
}

.book-info {
  flex: 1;
  min-width: 0;
  margin: 0 24rpx 0 28rpx;
}

.book-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.end {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.ring-pct {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.ring-sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.session {
  background: var(--color-bg);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 36rpx 0;
}

.session-meta {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.session-label {
  font-size: 36rpx;
  font-weight: 500;
  margin-top: 12rpx;
  line-height: 1.4;
}

.done {
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

.catchup-link {
  margin: -12rpx 0 28rpx;
  text-align: right;
}

.week-card {
  padding: 32rpx;
}

.week-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.week {
  display: flex;
  justify-content: space-between;
}

.week-day {
  text-align: center;
  flex: 1;
  font-size: 24rpx;
}

.dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin: 12rpx auto 0;
  font-size: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
