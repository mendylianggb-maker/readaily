.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.cards {
  margin-left: 24rpx;
}

.link {
  color: var(--color-primary);
  font-size: 28rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.step {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  text-align: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.center {
  text-align: center;
}

.book {
  display: flex;
}

.cover {
  width: 140rpx;
  height: 196rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.placeholder {
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}

.book-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.book-title {
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress {
  height: 10rpx;
  background: #eeeeee;
  border-radius: 5rpx;
  margin: 20rpx 0 8rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--color-primary);
}

.session-label {
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0 24rpx;
}

.done {
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.catchup-link {
  margin: -16rpx 0 24rpx;
  text-align: right;
}

.week {
  display: flex;
  justify-content: space-between;
}

.week-day {
  text-align: center;
  flex: 1;
}

.dot {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  margin: 8rpx auto 0;
  font-size: 24rpx;
  box-sizing: border-box;
}
