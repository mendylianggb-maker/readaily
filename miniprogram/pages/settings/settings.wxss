.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.opt {
  padding: 8rpx 20rpx;
  margin: 6rpx 12rpx 6rpx 0;
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.opt.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}

.dev {
  border: 2rpx dashed #e0a000;
}

.dev-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.dev-today {
  margin-bottom: 12rpx;
}

.dev-note {
  font-size: 24rpx;
  margin: 16rpx 0 12rpx;
}
