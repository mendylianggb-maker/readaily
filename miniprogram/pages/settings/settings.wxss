.sample {
  padding: 40rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.opt {
  padding: 8rpx 20rpx;
  margin: 6rpx 12rpx 6rpx 0;
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.opt.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}
