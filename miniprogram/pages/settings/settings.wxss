.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.dev {
  border: 2rpx dashed #CBBFAA;
  box-shadow: none;
}

.dev-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.dev-today {
  margin-bottom: 12rpx;
}

.dev-note {
  font-size: 24rpx;
  margin: 16rpx 0 12rpx;
}
