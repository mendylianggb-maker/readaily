.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-title {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.options {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.dev {
  border: 2rpx dashed #CBBFAA;
  box-shadow: none;
}

.dev-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.dev-today {
  margin-bottom: 12rpx;
}

.dev-note {
  font-size: 24rpx;
  margin: 16rpx 0 12rpx;
}

.version {
  text-align: center;
  font-size: 22rpx;
  padding: 32rpx 0 16rpx;
}

.card-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.backup-note {
  font-size: 26rpx;
  line-height: 1.6;
}

.backup-last {
  font-size: 24rpx;
  margin: 16rpx 0 24rpx;
}

.backup-actions {
  display: flex;
  gap: 20rpx;
}

.backup-actions button {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  letter-spacing: 0;
}
