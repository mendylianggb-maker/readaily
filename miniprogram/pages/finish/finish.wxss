.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.confetti {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
}

.piece {
  position: absolute;
  top: -40rpx;
  width: 16rpx;
  height: 28rpx;
  border-radius: 4rpx;
  opacity: 0.9;
  animation-name: fall;
  animation-timing-function: linear;
  animation-iteration-count: 2;
  animation-fill-mode: forwards;
}

@keyframes fall {
  0% { top: -40rpx; opacity: 1; }
  100% { top: 105vh; opacity: 0.7; }
}

.content {
  position: relative;
  padding: 120rpx 48rpx 48rpx;
  text-align: center;
}

.big {
  font-size: 120rpx;
}

.headline {
  font-size: 56rpx;
  font-weight: 700;
}

.book-title {
  font-size: 34rpx;
  margin: 8rpx 0 48rpx;
}

.stats {
  display: flex;
}

.stat {
  flex: 1;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
}

.message {
  margin: 24rpx 0 56rpx;
  font-size: 32rpx;
  line-height: 1.8;
}

.secondary {
  margin-top: 24rpx;
}
