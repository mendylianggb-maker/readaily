.empty {
  text-align: center;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.book {
  width: 33.33%;
  padding: 0 12rpx 32rpx;
  box-sizing: border-box;
}

.cover {
  width: 100%;
  height: 290rpx;
  border-radius: 12rpx;
  display: block;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.placeholder-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.book-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-info {
  font-size: 22rpx;
}

.import {
  margin-top: 16rpx;
}

.hint {
  margin-top: 16rpx;
  text-align: center;
}
