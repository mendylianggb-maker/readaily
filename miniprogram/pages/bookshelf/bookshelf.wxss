.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 36rpx;
}

.head-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
}

button.import {
  width: auto;
  margin: 0;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 0;
}

.empty {
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -16rpx;
}

.book {
  width: 50%;
  padding: 0 16rpx 40rpx;
  box-sizing: border-box;
}

.marker {
  margin-top: auto;
}

.mark-done,
.mark-new {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50%;
  text-align: center;
  font-family: var(--font-sans);
}

.mark-done {
  background: rgba(43, 38, 32, 0.55);
  color: #FFFDF8;
  font-size: 40rpx;
}

.mark-new {
  border: 4rpx solid rgba(255, 253, 248, 0.8);
  box-sizing: border-box;
  line-height: 80rpx;
  color: rgba(43, 38, 32, 0.6);
  font-size: 24rpx;
}

.mark-ring-inner {
  background: rgba(255, 253, 248, 0.85);
  font-family: var(--font-sans);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text);
}

.book-title {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.book-meta .text-secondary {
  font-size: 24rpx;
}

.badge {
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--color-soft);
  color: #5E5448;
}

.badge-reading {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.badge-new {
  background: transparent;
  border: 1rpx solid #CBBFAA;
}

.hint {
  margin-top: 8rpx;
  text-align: center;
}
