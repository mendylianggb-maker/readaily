<view class="container">
  <view class="head">
    <view class="head-title serif">我的书</view>
    <button class="btn-secondary import" bindtap="onImport">＋ 导入</button>
  </view>

  <view wx:if="{{books.length === 0}}" class="card empty">
    <view class="serif empty-title">书架上还没有书</view>
    <view class="text-secondary">把 txt 或 epub 发到微信「文件传输助手」，再回来导入。</view>
  </view>

  <view class="grid">
    <view
      wx:for="{{books}}"
      wx:key="id"
      class="book"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
      bindtap="onBookTap"
      bindlongpress="onBookLongPress"
    >
      <book-cover title="{{item.title}}" author="{{item.author}}" cover-path="{{item.coverPath}}" size="large">
        <view class="marker">
          <view wx:if="{{item.status === 'finished'}}" class="mark-done">✓</view>
          <view wx:elif="{{item.status === 'new'}}" class="mark-new">新</view>
          <view
            wx:else
            class="ring"
            style="width: 88rpx; height: 88rpx; background: conic-gradient(rgba(43, 38, 32, 0.6) 0 {{item.progress}}%, rgba(255, 253, 248, 0.7) {{item.progress}}% 100%)"
          >
            <view class="ring-inner mark-ring-inner" style="width: 68rpx; height: 68rpx">{{item.progress}}%</view>
          </view>
        </view>
      </book-cover>
      <view class="book-title">{{item.title}}</view>
      <view class="book-meta">
        <text class="badge badge-{{item.status}}">{{item.statusText}}</text>
        <text class="text-secondary">{{item.info}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{books.length}}" class="text-secondary hint">点一本书可以开始读、查看附加内容或删除</view>
</view>
