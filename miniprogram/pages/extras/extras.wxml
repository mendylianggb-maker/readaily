<view class="container">
  <view class="text-secondary intro">《{{title}}》导入时没放进每天阅读的内容，可以随时翻看，不算打卡。</view>
  <view class="card">
    <view wx:for="{{items}}" wx:key="index" class="item" data-index="{{index}}" bindtap="onOpen">
      <text>{{item}}</text>
      <text class="text-secondary">›</text>
    </view>
    <view wx:if="{{!items.length}}" class="text-secondary">没有附加内容</view>
  </view>
</view>
