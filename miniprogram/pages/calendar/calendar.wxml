<view class="container">
  <view class="stats">
    <view class="stat">
      <view class="text-secondary">连续</view>
      <view class="stat-value serif primary">{{stats.streak}}<text class="stat-unit">天</text></view>
    </view>
    <view class="stat">
      <view class="text-secondary">累计</view>
      <view class="stat-value serif">{{stats.total}}<text class="stat-unit">天</text></view>
    </view>
    <view class="stat" bindtap="onCardsTap">
      <view class="text-secondary">时光书签 <text class="help" catchtap="onExplain">?</text></view>
      <view class="stat-value serif gold">{{stats.cards}}<text class="stat-unit">/ 3</text></view>
    </view>
  </view>

  <view wx:if="{{hasBook}}" class="text-secondary book-line">
    《{{stats.title}}》已读 {{stats.progress}}% · 预计 {{stats.endLabel}} 读完
  </view>

  <view wx:if="{{stats.rescheduleReason}}" class="banner">
    <text wx:if="{{stats.rescheduleReason === 'behind'}}">落后 {{stats.overdue}} 天了</text>
    <text wx:else>已经提前读了 {{stats.ahead}} 天</text>
    <text class="link" bindtap="onReschedule">重新排期 ›</text>
  </view>

  <view wx:if="{{bookmarkMode}}" class="banner">
    <text>选一个黄色的日子，把它标为按时完成</text>
    <text class="link" bindtap="onCancelBookmark">取消</text>
  </view>

  <view class="card">
    <view class="month-bar">
      <text class="arrow" bindtap="onPrevMonth">‹</text>
      <text class="serif month">{{year}} 年 {{month}} 月</text>
      <text class="arrow" bindtap="onNextMonth">›</text>
    </view>
    <view class="grid">
      <view wx:for="{{weekdays}}" wx:key="*this" class="cell weekday text-secondary">{{item}}</view>
      <view
        wx:for="{{cells}}"
        wx:key="key"
        class="cell"
        data-index="{{item.empty ? -1 : item.index}}"
        data-state="{{item.state}}"
        bindtap="onDayTap"
      >
        <view
          wx:if="{{!item.empty}}"
          class="day state-{{item.state}} {{item.isToday ? 'is-today' : ''}} {{bookmarkMode && item.state !== 'late' ? 'dim' : ''}}"
        >{{item.day}}</view>
      </view>
    </view>
    <view class="legend text-secondary">
      <text><text class="swatch state-onTime"></text>按时</text>
      <text><text class="swatch state-late"></text>补读</text>
      <text><text class="swatch state-overdue"></text>待读</text>
      <text><text class="swatch state-upcoming"></text>未到</text>
    </view>
  </view>

  <view wx:if="{{!hasBook}}" class="text-secondary center">现在没有在读的书，日历会在开始读一本书后显示计划。</view>
</view>
