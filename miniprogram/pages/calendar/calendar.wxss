.stats {
  display: flex;
  margin-bottom: 20rpx;
}

.stat {
  flex: 1;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-right: 20rpx;
}

.stat:last-child {
  margin-right: 0;
}

.stat .text-secondary {
  font-size: 24rpx;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.stat-unit {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
  margin-left: 6rpx;
}

.primary {
  color: var(--color-primary);
}

.gold {
  color: var(--color-gold);
}

.help {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid var(--color-text-secondary);
  font-size: 20rpx;
  margin-left: 6rpx;
}

.book-line {
  margin: 8rpx 0 28rpx;
  text-align: center;
}

.month-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.month {
  font-size: 34rpx;
  font-weight: 700;
}

.arrow {
  font-size: 48rpx;
  padding: 0 24rpx;
  color: var(--color-text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.weekday {
  height: 56rpx;
  font-size: 24rpx;
}

.day {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  font-size: 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dim {
  opacity: 0.3;
}

.legend {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-soft);
  font-size: 22rpx;
}

.swatch {
  display: inline-block;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
  box-sizing: border-box;
}

.center {
  text-align: center;
}
