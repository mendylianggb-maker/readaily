.stats {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
}

.help {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 50%;
  border: 1rpx solid #aaaaaa;
  font-size: 20rpx;
  margin-left: 6rpx;
}

.book-line {
  margin: -8rpx 0 24rpx;
  text-align: center;
}

.banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.bookmark-bar {
  background: #fff8e1;
}

.link {
  color: var(--color-primary);
}

.month-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.arrow {
  font-size: 44rpx;
  padding: 0 24rpx;
  color: var(--color-text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.28%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  box-sizing: border-box;
}

.dim {
  opacity: 0.3;
}

.legend {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.swatch {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
  box-sizing: border-box;
}

.center {
  text-align: center;
}
