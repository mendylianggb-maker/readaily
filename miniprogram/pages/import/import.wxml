<view class="container">
  <view wx:if="{{!book}}" class="card">
    <view>从微信聊天记录里选一本书（txt 或 epub）。</view>
    <view class="text-secondary">可以先把文件发到「文件传输助手」。</view>
  </view>

  <button
    class="{{book ? '' : 'btn-primary'}}"
    bindtap="onChooseFile"
    loading="{{loading}}"
    disabled="{{loading}}"
  >{{book ? '重新选择' : '选择文件'}}</button>

  <view wx:if="{{error}}" class="card text-danger gap-top">{{error}}</view>

  <block wx:if="{{book}}">
    <view class="card gap-top">
      <image wx:if="{{coverPreview}}" class="cover" src="{{coverPreview}}" mode="aspectFit" />
      <view class="field">
        <view class="text-secondary">书名</view>
        <input class="input" value="{{book.title}}" bindinput="onTitleInput" placeholder="请填写书名" />
      </view>
      <view class="field">
        <view class="text-secondary">作者</view>
        <input class="input" value="{{book.author}}" bindinput="onAuthorInput" placeholder="可不填" />
      </view>

      <view class="stats">
        <view class="stat">
          <view class="stat-value">{{book.amountText}}</view>
          <view class="text-secondary">{{book.languageText}}</view>
        </view>
        <view class="stat">
          <view class="stat-value">{{book.chapterCount || '无'}}</view>
          <view class="text-secondary">章节</view>
        </view>
        <view class="stat">
          <view class="stat-value">约 {{book.days}} 天</view>
          <view class="text-secondary">每天 {{book.dailyMinutes}} 分钟</view>
        </view>
      </view>
      <view class="text-secondary">{{file.name}} · {{file.sizeText}} · {{book.detail}}</view>
    </view>

    <view class="card">
      <view class="card-head">
        <text class="text-secondary">{{book.chapterCount ? '目录' : '没有识别到章节，会按段落拆分每天的阅读量。'}}</text>
        <text wx:if="{{items.length}}" class="link" bindtap="onToggleItems">{{showItems ? '完成' : '调整内容'}}</text>
      </view>
      <block wx:if="{{!showItems}}">
        <view wx:for="{{chapterTitles}}" wx:key="index" class="chapter">{{item}}</view>
        <view wx:if="{{book.chapterCount > chapterTitles.length}}" class="text-secondary more">
          …… 共 {{book.chapterCount}} 章
        </view>
      </block>
      <block wx:else>
        <view class="text-secondary gap-small">勾选的内容会放进每天的阅读。没勾选的（比如版权页、致谢）不占阅读天数，导入后可以在书架里查看。</view>
        <view
          wx:for="{{items}}"
          wx:key="index"
          class="item"
          data-index="{{index}}"
          bindtap="onItemTap"
        >
          <text class="check">{{item.included ? '☑' : '☐'}}</text>
          <text class="{{item.included ? '' : 'text-secondary'}}">{{item.title}}</text>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="text-secondary">开头预览</view>
      <text class="preview" user-select>{{preview}}</text>
    </view>

    <button class="btn-primary" bindtap="onConfirm">确认导入</button>
  </block>
</view>
