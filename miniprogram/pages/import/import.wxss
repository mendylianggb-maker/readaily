.gap-top {
  margin-top: var(--space);
}

.field {
  margin-bottom: 24rpx;
}

.input {
  border-bottom: 1rpx solid #e5e5e5;
  padding: 12rpx 0;
  font-size: 34rpx;
}

.stats {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
}

.chapter {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.toggle {
  padding-top: 16rpx;
  color: var(--color-primary);
  text-align: center;
  font-size: 28rpx;
}

.preview {
  display: block;
  margin-top: 16rpx;
  white-space: pre-wrap;
  font-size: 28rpx;
}
