.gap-top {
  margin-top: var(--space);
}

.field {
  margin-bottom: 24rpx;
}

.input {
  border-bottom: 1rpx solid #e5e5e5;
  padding: 12rpx 0;
  font-size: 34rpx;
}

.stats {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
}

.chapter {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.more {
  padding-top: 16rpx;
}

.preview {
  display: block;
  margin-top: 16rpx;
  white-space: pre-wrap;
  font-size: 28rpx;
}

.cover {
  display: block;
  width: 200rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  border-radius: 8rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.link {
  color: var(--color-primary);
  font-size: 28rpx;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.gap-small {
  margin: 16rpx 0 8rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.check {
  margin-right: 16rpx;
  font-size: 34rpx;
}
