/* Design tokens. Restyle the app by changing these. */
page {
  --color-bg: #f7f7f7;
  --color-surface: #ffffff;
  --color-text: #222222;
  --color-text-secondary: #888888;
  --color-primary: #2f7d4f;
  --color-danger: #c0392b;
  --radius: 16rpx;
  --space: 32rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 1.6;
}

.container {
  padding: var(--space);
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: var(--space);
  margin-bottom: var(--space);
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: var(--radius);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.text-danger {
  color: var(--color-danger);
}

/* Session state marks, shared by home week strip and calendar. */
.state-onTime { background: #4caf7a; color: #fff; }
.state-late { background: #f2c14e; color: #fff; }
.state-overdue { background: #dddddd; color: #888; }
.state-today, .state-upcoming { border: 2rpx solid #c8c8c8; }
.state-none { color: #bbbbbb; }
.is-today { box-shadow: 0 0 0 4rpx var(--color-primary); }
