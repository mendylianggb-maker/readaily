.cover {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 4rpx 4rpx 0 #D8CDB9;
  flex-shrink: 0;
}

.cover-small {
  width: 120rpx;
  height: 168rpx;
}

.cover-large {
  width: 100%;
  height: 440rpx;
  border-radius: 12rpx;
  box-shadow: 6rpx 6rpx 0 #D8CDB9;
}

.image {
  display: block;
  width: 100%;
  height: 100%;
}

.placeholder {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
}

.cover-small .placeholder {
  padding: 16rpx 14rpx;
}

.cover-large .placeholder {
  padding: 32rpx 28rpx;
}

.title {
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.cover-small .title {
  font-size: 24rpx;
  -webkit-line-clamp: 3;
}

.cover-large .title {
  font-size: 38rpx;
  -webkit-line-clamp: 4;
}

.author {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cover-small .author {
  font-size: 18rpx;
}

.cover-large .author {
  font-size: 24rpx;
}
